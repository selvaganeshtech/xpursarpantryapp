rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the site link can read and write these collections (no login, same as the original app).
    match /team/{id}     { allow read, write: if true; }
    match /orders/{id}   { allow read, write: if true; }
    match /calls/{id}    { allow read, write: if true; }
    match /settings/{id} { allow read, write: if true; }
    match /{document=**} { allow read, write: if false; }
  }
}
